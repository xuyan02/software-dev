# Foundry runtime configuration (example).
#
# Copy to ~/.foundry/foundry.toml. Foundry reads no environment variables.
# Missing keys fall back to built-in defaults.
# Unknown keys are rejected at startup so typos fail loudly.
#
# The config file can contain the database password and the initialization
# passphrase; keep it readable only by its owner (chmod 600).

addr = "127.0.0.1:8080"
database_url = "postgres://foundry:foundry@localhost:5432/foundry"

# Initial account used to sign in to the first-run setup flow. This is an
# authorization identity, not a system account.
bootstrap_handle = "admin"
# Display name prefilled on the new-administrator form.
bootstrap_name = "Administrator"

# Initial password paired with bootstrap_handle. While the account table is
# empty, this pair signs in to /setup and authorizes creation of the first
# administrator. It is NOT the administrator's password; the operator chooses
# that on the setup page. Required while the account table is empty, ignored
# afterwards.
bootstrap_password = "change-this-initialization-passphrase"

session_ttl_hours = 168

# Platform model used by managed agents. The key is never written to the
# database. Keep this file chmod 600.
openai_api_key = "sk-..."
openai_base_url = "https://api.deepseek.com/v1"
openai_model = "deepseek-chat"

# GitHub App used to mint short-lived repository tokens. The private key stays
# in this file's directory (or wherever this path points) and is never sent to
# agents.
# github_app_id = 5785762
# github_app_private_key_file = "/home/me/.foundry/github-app.pem"
# github_api_base = "https://api.github.com"

# Local ds-server. Defaults shown; the listen address must be reachable from
# agent containers, and design_space_agent_url overrides the host IP written
# into project records.
# design_space_root = "/home/me/.foundry/design-spaces"
# design_space_listen = "0.0.0.0:7700"
# design_space_token_file = "/home/me/.foundry/design-space-token"
# design_space_agent_url = "http://192.0.2.10:7700"

# Image used for an agent's persistent shell.
# shell_image = "localhost/openergasterion-shell:1"
