# Arche SSH access.
#
# Place this in /etc/ssh/sshd_config.d/arche.conf and reload sshd.
#
# Only the service account is exposed. Each authorized key is limited to one
# repository by foundry-arche-authorized-keys and foundry-arche-stdio.

Match User foundry-arche
    AuthorizedKeysCommand /usr/local/bin/foundry-arche-authorized-keys %u %k
    AuthorizedKeysCommandUser nobody
    PasswordAuthentication no
    PermitTTY no
    AllowTcpForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitUserEnvironment no
    # The per-key command in authorized_keys is the forced command.
    # Do not set ForceCommand here: it would override the per-repository
    # command emitted by foundry-arche-authorized-keys.
