ARG RUST_IMAGE=docker.io/library/rust:1-bookworm
ARG BASE_IMAGE=docker.io/library/debian:bookworm-slim

FROM ${RUST_IMAGE} AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release --bin linux-capsule-sidecar

FROM ${BASE_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb \
        openbox \
        xfonts-base \
        fonts-dejavu-core \
        dbus-x11 \
        libgl1-mesa-dri \
        xterm \
        x11-apps \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /src/target/release/linux-capsule-sidecar /usr/local/bin/linux-capsule-sidecar
COPY images/linux-capsule/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENV DISPLAY=:99 \
    LINUX_CAPSULE_MODE=desktop \
    LINUX_CAPSULE_SCREEN=1280x800x24 \
    LIBGL_ALWAYS_SOFTWARE=1 \
    LANG=C.UTF-8

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
