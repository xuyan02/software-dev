{
  "schema_version": 1,
  "roles": [
    {"name": "summarizer", "kind": "agent"}
  ],
  "initial_stage": "summary",
  "stages": [
    {
      "name": "summary",
      "active_roles": ["summarizer"],
      "operations": [
        {
          "name": "completed",
          "display_name": "Complete summary",
          "description": "The source summary was written, reviewed, verified, committed and pushed.",
          "roles": ["summarizer"],
          "action": "result = 'completed'"
        },
        {
          "name": "failed",
          "display_name": "Summary failed",
          "description": "The summary could not be completed.",
          "roles": ["summarizer"],
          "action": "result = 'failed'"
        }
      ],
      "transitions": [
        {"on": "result == 'completed'", "to": "ended"},
        {"on": "result == 'failed'", "to": "ended"}
      ]
    }
  ]
}
