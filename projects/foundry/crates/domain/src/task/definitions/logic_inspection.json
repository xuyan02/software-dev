{
  "schema_version": 1,
  "roles": [
    {"name": "logic_inspector", "kind": "agent", "assignment": "logic_inspection"}
  ],
  "initial_stage": "inspect",
  "stages": [
    {
      "name": "inspect",
      "active_roles": [
        "logic_inspector"
      ],
      "vars": {
        "completed": {
          "type": "bool",
          "display_name": "Completed"
        },
        "failed": {
          "type": "bool",
          "display_name": "Failed"
        }
      },
      "operations": [
        {
          "name": "completed",
          "display_name": "代码逻辑检查完成",
          "description": "检查现有代码的正确性、边界、错误处理和资源问题。",
          "roles": [
            "logic_inspector"
          ],
          "action": "completed = true"
        },
        {
          "name": "failed",
          "display_name": "代码逻辑检查失败",
          "description": "无法完成检查。",
          "roles": [
            "logic_inspector"
          ],
          "action": "failed = true"
        }
      ],
      "transitions": [
        {
          "on": "failed",
          "action": "result = 'failed'",
          "to": "failed"
        },
        {
          "on": "completed",
          "action": "result = 'completed'",
          "to": "ended"
        }
      ]
    },
    {
      "name": "failed",
      "active_roles": [],
      "retry_to": "inspect"
    }
  ]
}
