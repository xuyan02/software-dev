{
  "schema_version": 1,
  "roles": [
    {"name": "designer", "kind": "agent", "assignment": "design_change"},
    {"name": "design_reviewer", "kind": "agent", "assignment": "design_change"},
    {"name": "acceptor", "kind": "human", "assignment": "design_space_reviewer"}
  ],
  "initial_stage": "analysis",
  "stages": [
    {
      "name": "analysis",
      "active_roles": ["designer"],
      "vars": {
        "analyzed": {"type": "bool", "display_name": "Analyzed"},
        "failed": {"type": "bool", "display_name": "Failed"}
      },
      "operations": [
        {"name": "analyzed", "display_name": "设计影响分析完成", "description": "受影响的系统、模块、对象和设计变更范围已明确。", "roles": ["designer"], "action": "analyzed = true"},
        {"name": "failed", "display_name": "分析失败", "description": "无法完成设计影响分析。", "roles": ["designer"], "action": "failed = true"}
      ],
      "transitions": [
        {"on": "failed", "to": "failed"},
        {"on": "analyzed", "to": "design"}
      ]
    },
    {
      "name": "design",
      "active_roles": ["designer"],
      "vars": {
        "designed": {"type": "bool", "display_name": "Designed"},
        "failed": {"type": "bool", "display_name": "Failed"}
      },
      "operations": [
        {"name": "designed", "display_name": "设计修改完成", "description": "设计修改已提交并推送到 design-change/<task-id> 分支。", "roles": ["designer"], "action": "designed = true"},
        {"name": "failed", "display_name": "设计修改失败", "description": "无法完成设计修改。", "roles": ["designer"], "action": "failed = true"}
      ],
      "transitions": [
        {"on": "failed", "to": "failed"},
        {"on": "designed", "to": "design_review"}
      ]
    },
    {
      "name": "design_review",
      "active_roles": ["design_reviewer"],
      "vars": {
        "decision": {"type": "string", "display_name": "Decision"},
        "failed": {"type": "bool", "display_name": "Failed"}
      },
      "operations": [
        {"name": "approved", "display_name": "设计通过", "description": "设计修改和影响范围通过，并已创建/刷新合并请求。", "roles": ["design_reviewer"], "action": "decision = 'approved'"},
        {"name": "rejected", "display_name": "设计打回", "description": "设计修改需要继续调整。", "roles": ["design_reviewer"], "action": "decision = 'rejected'"},
        {"name": "failed", "display_name": "设计审查失败", "description": "无法完成审查或创建合并请求。", "roles": ["design_reviewer"], "action": "failed = true"}
      ],
      "transitions": [
        {"on": "failed", "to": "failed"},
        {"on": "decision == 'approved'", "to": "human_review"},
        {"on": "decision == 'rejected'", "to": "design"}
      ]
    },
    {
      "name": "human_review",
      "active_roles": ["acceptor"],
      "vars": {
        "decision": {"type": "string", "display_name": "Decision"},
        "merged": {"type": "bool", "display_name": "Merged"},
        "conflict": {"type": "bool", "display_name": "Conflict"}
      },
      "operations": [
        {"name": "merge", "display_name": "批准并合入", "description": "人类批准后平台立即机械合入设计变更。", "roles": ["acceptor"], "action": "merged = true"},
        {"name": "conflict", "display_name": "合入未完成", "description": "机械合入失败，转智能体解决冲突或清理评论后重新审批。", "roles": ["acceptor"], "action": "conflict = true"},
        {"name": "rejected", "display_name": "人类打回", "description": "设计修改需要继续调整。", "roles": ["acceptor"], "action": "decision = 'rejected'"}
      ],
      "transitions": [
        {"on": "conflict", "to": "conflict_resolution"},
        {"on": "merged", "to": "cleanup"},
        {"on": "decision == 'rejected'", "to": "design"}
      ]
    },
    {
      "name": "conflict_resolution",
      "active_roles": ["designer"],
      "vars": {
        "resolved": {"type": "bool", "display_name": "Resolved"},
        "failed": {"type": "bool", "display_name": "Failed"}
      },
      "operations": [
        {"name": "resolved", "display_name": "冲突已解决", "description": "design-change 分支已 rebase、清理评论并刷新合并请求。", "roles": ["designer"], "action": "resolved = true"},
        {"name": "failed", "display_name": "无法解决", "description": "冲突无法解决。", "roles": ["designer"], "action": "failed = true"}
      ],
      "transitions": [
        {"on": "resolved", "to": "design_review"},
        {"on": "failed", "to": "failed"}
      ]
    },
    {
      "name": "cleanup",
      "active_roles": ["design_reviewer"],
      "vars": {
        "cleaned": {"type": "bool", "display_name": "Cleaned"},
        "failed": {"type": "bool", "display_name": "Failed"}
      },
      "operations": [
        {"name": "cleaned", "display_name": "清理完成", "description": "design-change 临时分支已删除。", "roles": ["design_reviewer"], "action": "cleaned = true"},
        {"name": "failed", "display_name": "清理失败", "description": "临时分支删除失败。", "roles": ["design_reviewer"], "action": "failed = true"}
      ],
      "transitions": [
        {"on": "cleaned", "action": "result = 'approved'", "to": "ended"},
        {"on": "failed", "to": "cleanup_failed"}
      ]
    },
    {
      "name": "cleanup_failed",
      "active_roles": [],
      "retry_to": "cleanup"
    },
    {
      "name": "failed",
      "active_roles": [],
      "retry_to": "analysis"
    }
  ]
}
