{
  "schema_version": 1,
  "roles": [
    {"name": "dispatcher", "kind": "agent", "assignment": "design_iteration"},
    {"name": "verifier", "kind": "agent", "assignment": "design_iteration"}
  ],
  "vars": {
    "expected": {
      "type": "int",
      "display_name": "Expected design tasks",
      "initial": -1
    },
    "done": {
      "type": "int",
      "display_name": "Completed design tasks"
    },
    "failed": {
      "type": "int",
      "display_name": "Failed design tasks"
    },
    "no_work": {
      "type": "bool",
      "display_name": "No work"
    },
    "outcome": {
      "type": "string",
      "display_name": "Outcome"
    }
  },
  "initial_stage": "dispatch",
  "stages": [
    {
      "name": "dispatch",
      "active_roles": ["dispatcher"],
      "operations": [
        {
          "name": "dispatched",
          "display_name": "设计任务已创建",
          "description": "已从设计池选批，并为每个设计工作创建了子任务。",
          "roles": ["dispatcher"],
          "action": "expected = count_children('design') + count_children('design_baseline')"
        },
        {
          "name": "nothing",
          "display_name": "没有可设计的议题",
          "description": "设计池为空，或当前没有可以立即开始设计的议题。",
          "roles": ["dispatcher"],
          "action": "no_work = true"
        }
      ],
      "transitions": [
        {"on": "no_work", "action": "result = 'no_work'", "to": "ended"},
        {"on": "expected > 0", "to": "waiting"},
        {"on": "expected == 0", "action": "result = 'no_work'", "to": "ended"}
      ]
    },
    {
      "name": "waiting",
      "active_roles": [],
      "events": [
        {
          "event": "child.state_changed",
          "action": "if (event.child.workflow == 'design' or event.child.workflow == 'design_baseline') and event.child.state == 'completed' { done = done + 1 } if (event.child.workflow == 'design' or event.child.workflow == 'design_baseline') and event.child.state == 'failed' { failed = failed + 1 }"
        }
      ],
      "transitions": [
        {"on": "done + failed == expected", "to": "verify"}
      ]
    },
    {
      "name": "verify",
      "active_roles": ["verifier"],
      "operations": [
        {
          "name": "ready",
          "display_name": "本轮验收通过",
          "description": "本轮计划的设计任务全部完成且质量合格，轮次议题已写验收结论并关闭。",
          "roles": ["verifier"],
          "action": "outcome = 'ready'"
        },
        {
          "name": "blocked",
          "display_name": "本轮存在无法完成项",
          "description": "存在无法完成的设计，相关议题已退回议题池，轮次议题已写结论并关闭。",
          "roles": ["verifier"],
          "action": "outcome = 'blocked'"
        },
        {
          "name": "rework",
          "display_name": "需要继续完善",
          "description": "存在不合格但可继续完善的设计；已创建同类型后续任务并转交议题。",
          "roles": ["verifier"],
          "action": "outcome = 'rework'\nexpected = count_children('design') + count_children('design_baseline')"
        }
      ],
      "transitions": [
        {"on": "outcome == 'ready'", "action": "result = 'completed'", "to": "ended"},
        {"on": "outcome == 'blocked'", "action": "result = 'blocked'", "to": "ended"},
        {"on": "outcome == 'rework'", "to": "waiting"}
      ]
    }
  ]
}
