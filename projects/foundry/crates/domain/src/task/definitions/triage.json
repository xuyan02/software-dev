{
  "schema_version": 1,
  "roles": [
    {"name": "triage", "kind": "agent", "assignment": "triage"}
  ],
  "vars": {
    "done": {
      "type": "bool",
      "display_name": "Done"
    },
    "wake": {
      "type": "bool",
      "display_name": "Wake"
    }
  },
  "initial_stage": "triage",
  "stages": [
    {
      "name": "triage",
      "active_roles": ["triage"],
      "operations": [
        {
          "name": "done",
          "display_name": "本轮分诊完成",
          "description": "当前批次的待分诊 Issue 已处理完。",
          "roles": ["triage"],
          "action": "done = true"
        }
      ],
      "transitions": [
        {"on": "done", "action": "done = false", "to": "waiting"}
      ]
    },
    {
      "name": "waiting",
      "active_roles": ["triage"],
      "operations": [
        {
          "name": "issue_arrived",
          "display_name": "收到 Issue 事件",
          "description": "有新 Issue 或 Issue 更新，开始分诊。",
          "roles": ["triage"],
          "action": "wake = true"
        }
      ],
      "transitions": [
        {"on": "wake", "action": "wake = false", "to": "triage"}
      ]
    }
  ]
}
