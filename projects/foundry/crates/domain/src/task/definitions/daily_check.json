{
  "schema_version": 1,
  "roles": [
    {"name": "dispatcher", "kind": "agent", "assignment": "daily_check"}
  ],
  "initial_stage": "dispatch",
  "stages": [
    {
      "name": "dispatch",
      "active_roles": ["dispatcher"],
      "vars": {
        "dispatched": {"type": "bool", "display_name": "Dispatched"},
        "failed": {"type": "bool", "display_name": "Failed"}
      },
      "operations": [
        {"name": "dispatched", "display_name": "检查任务已创建", "description": "设计检查任务已创建。", "roles": ["dispatcher"], "action": "dispatched = true"},
        {"name": "failed", "display_name": "创建检查任务失败", "description": "无法创建设计检查子任务。", "roles": ["dispatcher"], "action": "failed = true"}
      ],
      "transitions": [
        {"on": "failed", "to": "failed"},
        {"on": "dispatched", "to": "waiting"}
      ]
    },
    {
      "name": "waiting",
      "active_roles": [],
      "vars": {
        "design_done": {"type": "bool", "display_name": "Design done"},
        "inspection_failed": {"type": "bool", "display_name": "Inspection failed"}
      },
      "events": [
        {
          "event": "child.state_changed",
          "action": "if event.child.workflow == 'design_inspection' and event.child.state == 'completed' { if event.child.result == 'completed' { design_done = true } else { inspection_failed = true } }"
        }
      ],
      "transitions": [
        {"on": "inspection_failed", "action": "result = 'failed'", "to": "failed"},
        {"on": "design_done", "action": "result = 'completed'", "to": "ended"}
      ]
    },
    {
      "name": "failed",
      "active_roles": [],
      "retry_to": "dispatch"
    }
  ]
}
