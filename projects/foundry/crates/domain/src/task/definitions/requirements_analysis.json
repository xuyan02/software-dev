{
  "schema_version": 1,
  "roles": [
    {"name": "analyst", "kind": "agent", "min_actors": 1, "max_actors": null},
    {"name": "style_reviewer", "kind": "agent", "min_actors": 1, "max_actors": null},
    {"name": "requirements_reviewer", "kind": "agent", "min_actors": 1, "max_actors": null},
    {"name": "feasibility_reviewer", "kind": "agent", "min_actors": 1, "max_actors": null},
    {"name": "acceptor", "kind": "any", "min_actors": 1, "max_actors": null}
  ],
  "initial_stage": "work",
  "stages": [
    {
      "name": "work",
      "active_roles": ["analyst"],
      "vars": {
        "completed": {"type": "bool", "display_name": "Completed"}
      },
      "created": [
        {"document_review_link": {"kind": "requirements", "action": "release"}}
      ],
      "operations": [
        {
          "name": "started",
          "display_name": "Start",
          "description": "Claim and start analyzing requirements.",
          "roles": ["analyst"],
          "action": ""
        },
        {
          "name": "completed",
          "display_name": "Submit for review",
          "description": "Submit the requirements draft for review.",
          "roles": ["analyst"],
          "action": "completed = true"
        }
      ],
      "transitions": [
        {"on": "completed", "to": "style_review"}
      ]
    },
    {
      "name": "style_review",
      "active_roles": ["style_reviewer"],
      "vars": {
        "decision": {"type": "string", "display_name": "Decision"}
      },
      "operations": [
        {
          "name": "approved",
          "display_name": "Approve",
          "description": "The document is clear; move to requirements review.",
          "roles": ["style_reviewer"],
          "action": "decision = 'approved'"
        },
        {
          "name": "rejected",
          "display_name": "Reject",
          "description": "The wording is unclear or ambiguous; return to the analyst.",
          "roles": ["style_reviewer"],
          "action": "decision = 'rejected'"
        }
      ],
      "transitions": [
        {"on": "decision == 'approved'", "to": "requirements_review"},
        {"on": "decision == 'rejected'", "to": "work"}
      ]
    },
    {
      "name": "requirements_review",
      "active_roles": ["requirements_reviewer"],
      "vars": {
        "decision": {"type": "string", "display_name": "Decision"}
      },
      "operations": [
        {
          "name": "approved",
          "display_name": "Approve",
          "description": "The requirements are complete and testable; move to feasibility review.",
          "roles": ["requirements_reviewer"],
          "action": "decision = 'approved'"
        },
        {
          "name": "rejected",
          "display_name": "Reject",
          "description": "The requirements need revision; return to the analyst.",
          "roles": ["requirements_reviewer"],
          "action": "decision = 'rejected'"
        }
      ],
      "transitions": [
        {"on": "decision == 'approved'", "to": "feasibility_review"},
        {"on": "decision == 'rejected'", "to": "work"}
      ]
    },
    {
      "name": "feasibility_review",
      "active_roles": ["feasibility_reviewer"],
      "vars": {
        "decision": {"type": "string", "display_name": "Decision"}
      },
      "operations": [
        {
          "name": "approved",
          "display_name": "Approve",
          "description": "The requirements are technically feasible; move to human review.",
          "roles": ["feasibility_reviewer"],
          "action": "decision = 'approved'"
        },
        {
          "name": "rejected",
          "display_name": "Reject",
          "description": "Feasibility concerns; return to the analyst.",
          "roles": ["feasibility_reviewer"],
          "action": "decision = 'rejected'"
        }
      ],
      "transitions": [
        {"on": "decision == 'approved'", "to": "human_review"},
        {"on": "decision == 'rejected'", "to": "work"}
      ]
    },
    {
      "name": "human_review",
      "active_roles": ["acceptor"],
      "vars": {
        "decision": {"type": "string", "display_name": "Decision"}
      },
      "created": [
        {"document_review_link": {"kind": "requirements", "action": "bind"}}
      ],
      "operations": [
        {
          "name": "approved",
          "display_name": "Approve and publish",
          "description": "The human accepts the requirements document.",
          "roles": ["acceptor"],
          "action": "decision = 'approved'"
        },
        {
          "name": "rejected",
          "display_name": "Reject",
          "description": "The human rejects the document; return to the analyst.",
          "roles": ["acceptor"],
          "action": "decision = 'rejected'"
        }
      ],
      "transitions": [
        {"on": "decision == 'approved'", "action": "result = 'approved'", "to": "ended"},
        {"on": "decision == 'rejected'", "to": "work"}
      ],
      "reject_to": "work"
    }
  ]
}
