{
  "schema_version": 1,
  "roles": [
    {"name": "triage", "kind": "agent", "min_actors": 1, "max_actors": 1}
  ],
  "initial_stage": "triage",
  "stages": [
    {
      "name": "triage",
      "active_roles": ["triage"],
      "vars": {
        "outcome": {"type": "string", "display_name": "Outcome"}
      },
      "operations": [
        {"name": "routed", "display_name": "已分诊并创建任务", "description": "已完成分类、根因判断和任务创建。", "roles": ["triage"], "action": "outcome = 'routed'"},
        {"name": "needs_info", "display_name": "需要补充信息", "description": "Issue 信息不足，等待报告人补充。", "roles": ["triage"], "action": "outcome = 'needs_info'"},
        {"name": "rejected", "display_name": "建议拒绝", "description": "判断不是问题，建议人类拒绝。", "roles": ["triage"], "action": "outcome = 'rejected'"},
        {"name": "duplicate", "display_name": "重复问题", "description": "判断为重复 Issue，建议人类合并。", "roles": ["triage"], "action": "outcome = 'duplicate'"},
        {"name": "failed", "display_name": "分诊失败", "description": "无法完成分诊。", "roles": ["triage"], "action": "outcome = 'failed'"}
      ],
      "transitions": [
        {"on": "outcome == 'routed'", "action": "result = 'routed'", "to": "ended"},
        {"on": "outcome == 'needs_info'", "action": "result = 'needs_info'", "to": "ended"},
        {"on": "outcome == 'rejected'", "action": "result = 'rejected'", "to": "ended"},
        {"on": "outcome == 'duplicate'", "action": "result = 'duplicate'", "to": "ended"},
        {"on": "outcome == 'failed'", "action": "result = 'failed'", "to": "failed"}
      ]
    },
    {
      "name": "failed",
      "active_roles": [],
      "retry_to": "triage"
    }
  ]
}
