{
  "schema_version": 1,
  "roles": [
    {
      "name": "assessor",
      "kind": "agent",
      "assignment": "software_development"
    }
  ],
  "vars": {
    "has_code": {
      "type": "bool",
      "display_name": "Has existing code"
    }
  },
  "initial_stage": "assessment",
  "stages": [
    {
      "name": "assessment",
      "active_roles": [
        "assessor"
      ],
      "operations": [
        {
          "name": "code_present",
          "display_name": "已有代码",
          "description": "仓库中已有可分析的源码。",
          "roles": [
            "assessor"
          ],
          "action": "has_code = true\nassessed = true"
        },
        {
          "name": "no_code",
          "display_name": "无代码",
          "description": "仓库为空或只有文档。",
          "roles": [
            "assessor"
          ],
          "action": "has_code = false\nassessed = true"
        },
        {
          "name": "failed",
          "display_name": "评估失败",
          "description": "无法读取项目仓库。",
          "roles": [
            "assessor"
          ],
          "action": "result = 'failed'"
        }
      ],
      "transitions": [
        {
          "on": "assessed == true",
          "to": "clarification"
        },
        {
          "on": "result == 'failed'",
          "to": "ended"
        }
      ],
      "vars": {
        "assessed": {
          "type": "bool",
          "display_name": "Assessed"
        }
      }
    },
    {
      "name": "clarification",
      "vars": {
        "outcome": {
          "type": "string",
          "display_name": "Outcome"
        }
      },
      "events": [
        {
          "event": "task.created",
          "action": "create_issue(kind = 'question', title = 'Project clarification: {task.title}', description = 'Discuss the project goal, users, success metrics, scope and risks. If source code exists, read it first and ask only for confirmation or corrections.', relation = 'clarifies', task_workflow = 'goal_clarification', task_title = '项目文档撰写')"
        },
        {
          "event": "child.state_changed",
          "action": "if event.child.workflow == 'goal_clarification' and event.child.state == 'completed' { if event.child.result == 'approved' { outcome = 'approved' } if event.child.result == 'failed' or event.child.result == 'infeasible' or event.child.result == 'obsolete' { outcome = 'failed' } }"
        }
      ],
      "transitions": [
        {
          "on": "outcome == 'approved'",
          "to": "requirements_discovery"
        },
        {
          "on": "outcome == 'failed'",
          "action": "result = 'failed'",
          "to": "ended"
        }
      ]
    },
    {
      "name": "requirements_discovery",
      "vars": {
        "outcome": {
          "type": "string",
          "display_name": "Outcome"
        }
      },
      "created": [
        {
          "create_child": {
            "workflow": "requirements_discovery",
            "title": "Discover the initial requirement pool"
          }
        }
      ],
      "events": [
        {
          "event": "child.state_changed",
          "action": "if event.child.workflow == 'requirements_discovery' and event.child.state == 'completed' { if event.child.result == 'approved' { outcome = 'approved' } if event.child.result == 'failed' or event.child.result == 'infeasible' or event.child.result == 'obsolete' { outcome = 'failed' } }"
        }
      ],
      "transitions": [
        {
          "on": "outcome == 'approved'",
          "to": "requirements_analysis"
        },
        {
          "on": "outcome == 'failed'",
          "action": "result = 'failed'",
          "to": "ended"
        }
      ]
    },
    {
      "name": "requirements_analysis",
      "vars": {
        "outcome": {
          "type": "string",
          "display_name": "Outcome"
        }
      },
      "created": [
        {
          "create_child": {
            "workflow": "requirements_analysis",
            "title": "Analyze and document requirements"
          }
        }
      ],
      "events": [
        {
          "event": "child.state_changed",
          "action": "if event.child.workflow == 'requirements_analysis' and event.child.state == 'completed' { if event.child.result == 'approved' { outcome = 'approved' } if event.child.result == 'failed' or event.child.result == 'infeasible' or event.child.result == 'obsolete' { outcome = 'failed' } }"
        }
      ],
      "transitions": [
        {
          "on": "outcome == 'approved'",
          "to": "interaction_design"
        },
        {
          "on": "outcome == 'failed'",
          "action": "result = 'failed'",
          "to": "ended"
        }
      ]
    },
    {
      "name": "interaction_design",
      "vars": {
        "outcome": {
          "type": "string",
          "display_name": "Outcome"
        }
      },
      "created": [
        {
          "create_child": {
            "workflow": "interaction_design",
            "title": "Design interactions"
          }
        }
      ],
      "events": [
        {
          "event": "child.state_changed",
          "action": "if event.child.workflow == 'interaction_design' and event.child.state == 'completed' { if event.child.result == 'approved' { outcome = 'approved' } if event.child.result == 'failed' or event.child.result == 'infeasible' or event.child.result == 'obsolete' { outcome = 'failed' } }"
        }
      ],
      "transitions": [
        {
          "on": "outcome == 'approved'",
          "to": "ui_design"
        },
        {
          "on": "outcome == 'failed'",
          "action": "result = 'failed'",
          "to": "ended"
        }
      ]
    },
    {
      "name": "ui_design",
      "vars": {
        "outcome": {
          "type": "string",
          "display_name": "Outcome"
        }
      },
      "created": [
        {
          "create_child": {
            "workflow": "ui_design",
            "title": "Design UI"
          }
        }
      ],
      "events": [
        {
          "event": "child.state_changed",
          "action": "if event.child.workflow == 'ui_design' and event.child.state == 'completed' { if event.child.result == 'approved' { outcome = 'approved' } if event.child.result == 'failed' or event.child.result == 'infeasible' or event.child.result == 'obsolete' { outcome = 'failed' } }"
        }
      ],
      "transitions": [
        {
          "on": "outcome == 'approved'",
          "to": "architecture"
        },
        {
          "on": "outcome == 'failed'",
          "action": "result = 'failed'",
          "to": "ended"
        }
      ]
    },
    {
      "name": "architecture",
      "vars": {
        "outcome": {
          "type": "string",
          "display_name": "Outcome"
        }
      },
      "created": [
        {
          "create_child": {
            "workflow": "architecture_design",
            "title": "Define architecture and key ADRs"
          }
        }
      ],
      "events": [
        {
          "event": "child.state_changed",
          "action": "if event.child.workflow == 'architecture_design' and event.child.state == 'completed' { if event.child.result == 'approved' { outcome = 'approved' } if event.child.result == 'failed' or event.child.result == 'infeasible' or event.child.result == 'obsolete' { outcome = 'failed' } }"
        }
      ],
      "transitions": [
        {
          "on": "outcome == 'approved'",
          "to": "detailed_design"
        },
        {
          "on": "outcome == 'failed'",
          "action": "result = 'failed'",
          "to": "ended"
        }
      ]
    },
    {
      "name": "detailed_design",
      "vars": {
        "outcome": {
          "type": "string",
          "display_name": "Outcome"
        }
      },
      "created": [
        {
          "create_child": {
            "workflow": "detailed_design",
            "title": "Write the detailed design"
          }
        }
      ],
      "events": [
        {
          "event": "child.state_changed",
          "action": "if event.child.workflow == 'detailed_design' and event.child.state == 'completed' { if event.child.result == 'approved' { outcome = 'approved' } if event.child.result == 'failed' or event.child.result == 'infeasible' or event.child.result == 'obsolete' { outcome = 'failed' } }"
        }
      ],
      "transitions": [
        {
          "on": "outcome == 'approved'",
          "to": "test_planning"
        },
        {
          "on": "outcome == 'failed'",
          "action": "result = 'failed'",
          "to": "ended"
        }
      ]
    },
    {
      "name": "test_planning",
      "vars": {
        "outcome": {
          "type": "string",
          "display_name": "Outcome"
        }
      },
      "created": [
        {
          "create_child": {
            "workflow": "test_planning",
            "title": "Write the test plan"
          }
        }
      ],
      "events": [
        {
          "event": "child.state_changed",
          "action": "if event.child.workflow == 'test_planning' and event.child.state == 'completed' { if event.child.result == 'approved' { outcome = 'approved' } if event.child.result == 'failed' or event.child.result == 'infeasible' or event.child.result == 'obsolete' { outcome = 'failed' } }"
        }
      ],
      "transitions": [
        {
          "on": "outcome == 'approved'",
          "to": "development"
        },
        {
          "on": "outcome == 'failed'",
          "action": "result = 'failed'",
          "to": "ended"
        }
      ]
    },
    {
      "name": "development",
      "vars": {
        "outcome": {
          "type": "string",
          "display_name": "Outcome"
        },
        "next": {
          "type": "bool",
          "display_name": "Next iteration"
        }
      },
      "created": [
        {
          "create_child": {
            "workflow": "iteration",
            "title": "Iteration {count_children('iteration') + 1}"
          }
        }
      ],
      "events": [
        {
          "event": "child.state_changed",
          "action": "if event.child.workflow == 'iteration' and event.child.state == 'completed' { if event.child.result == 'approved' { outcome = 'approved' } else if event.child.result == 'failed' or event.child.result == 'infeasible' or event.child.result == 'obsolete' { outcome = 'failed' } else { next = true } }"
        }
      ],
      "transitions": [
        {
          "on": "outcome == 'approved'",
          "to": "test_execution"
        },
        {
          "on": "outcome == 'failed'",
          "action": "result = 'failed'",
          "to": "ended"
        },
        {
          "on": "next",
          "to": "development"
        }
      ]
    },
    {
      "name": "test_execution",
      "vars": {
        "outcome": {
          "type": "string",
          "display_name": "Outcome"
        }
      },
      "created": [
        {
          "create_child": {
            "workflow": "test_execution",
            "title": "Execute tests and record evidence"
          }
        }
      ],
      "events": [
        {
          "event": "child.state_changed",
          "action": "if event.child.workflow == 'test_execution' and event.child.state == 'completed' { if event.child.result == 'approved' { outcome = 'approved' } if event.child.result == 'failed' or event.child.result == 'infeasible' or event.child.result == 'obsolete' { outcome = 'failed' } }"
        }
      ],
      "transitions": [
        {
          "on": "outcome == 'approved'",
          "to": "release"
        },
        {
          "on": "outcome == 'failed'",
          "action": "result = 'failed'",
          "to": "ended"
        }
      ]
    },
    {
      "name": "release",
      "vars": {
        "outcome": {
          "type": "string",
          "display_name": "Outcome"
        }
      },
      "created": [
        {
          "create_child": {
            "workflow": "release",
            "title": "Release and observe"
          }
        }
      ],
      "events": [
        {
          "event": "child.state_changed",
          "action": "if event.child.workflow == 'release' and event.child.state == 'completed' { if event.child.result == 'released' or event.child.result == 'approved' { outcome = 'approved' } if event.child.result == 'failed' or event.child.result == 'obsolete' { outcome = 'failed' } }"
        }
      ],
      "transitions": [
        {
          "on": "outcome == 'approved'",
          "to": "feedback"
        },
        {
          "on": "outcome == 'failed'",
          "action": "result = 'failed'",
          "to": "ended"
        }
      ]
    },
    {
      "name": "feedback",
      "vars": {
        "outcome": {
          "type": "string",
          "display_name": "Outcome"
        }
      },
      "created": [
        {
          "create_child": {
            "workflow": "feedback_cycle",
            "title": "Run the continuous feedback cycle"
          }
        }
      ],
      "events": [
        {
          "event": "child.state_changed",
          "action": "if event.child.workflow == 'feedback_cycle' and event.child.state == 'completed' { outcome = 'done' }"
        }
      ],
      "transitions": [
        {
          "on": "outcome == 'done'",
          "to": "running"
        }
      ]
    },
    {
      "name": "running",
      "created": [
        {
          "create_child": {
            "workflow": "triage",
            "title": "分诊"
          }
        }
      ]
    }
  ]
}
