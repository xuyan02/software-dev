{
  "title": "支持部分退款",
  "problem": "用户只能全额退款，客服需要手工处理部分退款。",
  "users": ["买家", "客服"],
  "acceptance": [
    {
      "id": "S-1",
      "title": "部分退款成功",
      "given": ["订单已支付 100 元"],
      "when": ["用户申请退款 30 元"],
      "then": ["退款成功且订单余额为 70 元"]
    },
    {
      "id": "S-2",
      "title": "超过订单金额的退款被拒绝",
      "given": ["订单已支付 100 元"],
      "when": ["用户申请退款 120 元"],
      "then": ["请求被拒绝并返回明确错误"]
    }
  ],
  "non_goals": ["不支持跨币种退款", "不做退款审批流"],
  "constraints": ["退款接口 P99 < 800ms"],
  "priority": "p1",
  "risk": "medium"
}
