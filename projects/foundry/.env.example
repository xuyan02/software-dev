FOUNDRY_ADDR=127.0.0.1:8080
RUST_LOG=foundry=debug,tower_http=debug
DATABASE_URL=postgres://foundry:foundry@localhost:5432/foundry
# First run: open http://127.0.0.1:8080/setup, sign in with the initial
# account (FOUNDRY_BOOTSTRAP_HANDLE, default "admin") and the initial password
# below, then create the real administrator account.
# Required only while the account table is empty. This is NOT an administrator
# password; it authorizes the setup flow. Ignored once accounts exist.
# FOUNDRY_BOOTSTRAP_PASSWORD=change-this-initialization-passphrase
